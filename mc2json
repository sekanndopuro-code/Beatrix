<!doctype html>
<html lang="ja">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Malody → Beatrix 譜面変換</title>
<style>
  :root { color-scheme: dark; }
  * { box-sizing: border-box; }
  html, body { margin: 0; min-height: 100%; background: #000; color: #fff; }
  body { font-family: -apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif; padding: 24px; }
  main { width: min(680px,100%); margin: 0 auto; }
  h1 { font-size: 20px; font-weight: 600; margin: 0 0 20px; }
  .row { display: flex; gap: 10px; flex-wrap: wrap; align-items: center; }
  button, .file-button {
    appearance: none; border: 1px solid #fff; background: #000; color: #fff;
    border-radius: 8px; padding: 11px 15px; font: inherit; cursor: pointer;
  }
  button:disabled { opacity: .45; cursor: default; }
  .file-button { display: inline-block; }
  input[type=file] { display: none; }
  #status { margin-top: 16px; min-height: 1.5em; white-space: pre-wrap; word-break: break-word; }
  #download { display: none; margin-top: 16px; }
  .sub { margin-top: 8px; color: #aaa; font-size: 13px; }
</style>
</head>
<body>
<main>
  <h1>Malody → Beatrix 譜面変換</h1>
  <div class="row">
    <label class="file-button" for="mcFile">mcを選択</label>
    <input id="mcFile" type="file">
  </div>
  <div id="status">ファイルを選択してください</div>
  <div class="sub">選択したファイルはブラウザ内だけで処理します。</div>
  <button id="download" type="button">jsonダウンロードする</button>
</main>
<script>
(() => {
  'use strict';

  const fileInput = document.getElementById('mcFile');
  const status = document.getElementById('status');
  const downloadButton = document.getElementById('download');
  let downloadUrl = null;
  let downloadName = '';

  // Malodyで今回の7鍵譜面に現れる代表的なX座標。
  // 実際のXはこの中心値に一番近い鍵へ量子化する。
  const LANE_X = [51, 77, 102, 128, 153, 179, 204];

  function gcd(a, b) {
    a = a < 0n ? -a : a;
    b = b < 0n ? -b : b;
    while (b !== 0n) {
      const r = a % b;
      a = b;
      b = r;
    }
    return a || 1n;
  }

  function rational(numerator, denominator) {
    let n = BigInt(numerator);
    let d = BigInt(denominator);
    if (d === 0n) throw new Error('0で割るbeatが含まれています');
    if (d < 0n) { n = -n; d = -d; }
    const g = gcd(n, d);
    return { n: n / g, d: d / g };
  }

  function addRational(a, b) {
    return rational(a.n * b.d + b.n * a.d, a.d * b.d);
  }

  function beatToRational(beat, isSegment) {
    if (!Array.isArray(beat) || beat.length !== 3) {
      throw new Error('beat形式が不正です');
    }
    const a = Number(beat[0]);
    const b = Number(beat[1]);
    const c = Number(beat[2]);
    if (![a, b, c].every(Number.isFinite) || !Number.isInteger(a) || !Number.isInteger(b) || !Number.isInteger(c) || c <= 0) {
      throw new Error('beatの値が不正です');
    }
    // note: [小節(1始まり), 分子, 分母]
    // seg : [相対拍, 分子, 分母]
    return rational(BigInt(isSegment ? a : a - 1) * BigInt(c) + BigInt(b), c);
  }

  function rationalToLPB(r) {
    if (r.n > BigInt(Number.MAX_SAFE_INTEGER) || r.n < BigInt(Number.MIN_SAFE_INTEGER) || r.d > BigInt(Number.MAX_SAFE_INTEGER)) {
      throw new Error('譜面の時間値が大きすぎます');
    }
    return { LPB: Number(r.d), num: Number(r.n) };
  }

  function nearestLaneBlock(x) {
    if (!Number.isFinite(x)) throw new Error('X座標が不正です');
    let best = 0;
    let bestDistance = Math.abs(x - LANE_X[0]);
    for (let i = 1; i < LANE_X.length; i++) {
      const distance = Math.abs(x - LANE_X[i]);
      if (distance < bestDistance) {
        best = i;
        bestDistance = distance;
      }
    }
    return best;
  }

  function convertMcToBeatrix(mc) {
    if (!mc || typeof mc !== 'object') throw new Error('データがJSONオブジェクトではありません');
    if (!mc.meta || typeof mc.meta !== 'object') throw new Error('Malody形式ではありません');
    if (Number(mc.meta.mode) !== 7) throw new Error('7KのMalody譜面ではありません');
    if (!Array.isArray(mc.note)) throw new Error('note配列がありません');
    if (!Array.isArray(mc.time) || mc.time.length === 0) throw new Error('BPM情報がありません');

    const bpms = mc.time.map(t => Number(t && t.bpm)).filter(Number.isFinite);
    if (bpms.length === 0) throw new Error('BPM情報が不正です');
    const firstBpm = bpms[0];
    // 出力形式が単一BPMなので、途中のBPM変更は無言で壊さず拒否する。
    if (bpms.some(b => b !== firstBpm)) throw new Error('BPM変更を含む譜面には対応していません');

    const song = mc.meta.song && typeof mc.meta.song === 'object' ? mc.meta.song : {};
    const title = typeof song.title === 'string' && song.title ? song.title : 'Untitled';
    const version = typeof mc.meta.version === 'string' && mc.meta.version ? mc.meta.version : '';
    const name = version ? `${title}(${version})` : title;

    const outNotes = [];

    for (const note of mc.note) {
      if (!note || typeof note !== 'object') throw new Error('noteに不正なデータがあります');
      // soundノーツはBeatrix譜面ノーツではないため除外。
      if (typeof note.sound === 'string') continue;

      const start = beatToRational(note.beat, false);
      const { LPB, num } = rationalToLPB(start);
      const block = nearestLaneBlock(Number(note.x));
      const originalType = Number.isInteger(Number(note.type)) ? Number(note.type) : 1;
      const segments = Array.isArray(note.seg) ? note.seg : [];

      if (segments.length > 0) {
        // seg付き：親(type 2) + 元ノーツ(type) + 子(type 2)
        const children = [];
        for (const seg of segments) {
          if (!seg || typeof seg !== 'object') throw new Error('segに不正なデータがあります');
          const segBeat = beatToRational(seg.beat, true);
          const absolute = addRational(start, segBeat);
          const childTime = rationalToLPB(absolute);
          const childX = Number(note.x) + Number(seg.x || 0);
          const childBlock = nearestLaneBlock(childX);
          children.push({
            LPB: childTime.LPB,
            num: childTime.num,
            block: childBlock,
            type: 2,
            notes: []
          });
        }

        outNotes.push({ LPB, num, block, type: 2, notes: children });
        outNotes.push({ LPB, num, block, type: originalType, notes: [] });
      } else {
        outNotes.push({ LPB, num, block, type: originalType, notes: [] });
      }
    }

    const result = {
      name,
      maxBlock: 7,
      BPM: firstBpm,
      LEVEL: 1.0,
      offset: 0,
      notes: outNotes
    };

    return result;
  }

  function makeDownloadName(inputName, json) {
    let base = inputName.replace(/\\.[^.\\/]+$/, '');
    if (/^Malody_/i.test(base)) base = base.slice(7);
    if (!base) base = json.name || 'chart';
    return base + '.json';
  }

  function resetDownload() {
    downloadButton.style.display = 'none';
    if (downloadUrl) {
      URL.revokeObjectURL(downloadUrl);
      downloadUrl = null;
    }
    downloadName = '';
  }

  function showError(message) {
    resetDownload();
    status.textContent = message;
  }

  fileInput.addEventListener('change', () => {
    resetDownload();
    const file = fileInput.files && fileInput.files[0];
    if (!file) {
      status.textContent = 'ファイルを選択してください';
      return;
    }

    status.textContent = '読み込み中...';
    const reader = new FileReader();
    reader.onload = () => {
      try {
        let text = String(reader.result || '');
        if (text.charCodeAt(0) === 0xFEFF) text = text.slice(1);
        const mc = JSON.parse(text);
        const json = convertMcToBeatrix(mc);
        const blob = new Blob([JSON.stringify(json)], { type: 'application/json;charset=utf-8' });
        downloadUrl = URL.createObjectURL(blob);
        downloadName = makeDownloadName(file.name, json);
        status.textContent = `変換完了：${downloadName}`;
        downloadButton.style.display = 'inline-block';
      } catch (error) {
        console.error(error);
        const detail = error && error.message ? `\n（${error.message}）` : '';
        showError(`非対応のデータ形式です${detail}`);
      }
    };
    reader.onerror = () => showError('ファイルを読み込めませんでした');
    reader.readAsText(file, 'utf-8');
  });

  downloadButton.addEventListener('click', () => {
    if (!downloadUrl) return;
    const a = document.createElement('a');
    a.href = downloadUrl;
    a.download = downloadName;
    document.body.appendChild(a);
    a.click();
    a.remove();
  });

  // テスト用にグローバルへ露出（通常利用では何もしない）。
  window.__malodyToBeatrix = { convertMcToBeatrix };
})();
</script>
</body>
</html>
